dist/
_site/
.jekyll-cache/
.jekyll-metadata
.sass-cache/
.cache/

# NOTE: If consumers pull this repo directly via git and require compiled assets,
# replace "dist/" above with the selective whitelist below:
# /dist/*
# !/dist/css/
# /dist/css/*
# !/dist/css/gloss.css
# !/dist/css/gloss.min.css
# !/dist/css/gloss-rtl.css
# !/dist/css/gloss-rtl.min.css
# !/dist/js/
# /dist/js/*
# !/dist/js/gloss.js
# !/dist/js/gloss.min.js

# Test and coverage output
coverage/
playwright-report/
test-results/

